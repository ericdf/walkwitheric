{
  "name": "walkwitheric",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npx @11ty/eleventy && npx tailwindcss -i ./src/css/input.css -o ./_site/css/style.css --minify",
    "dev": "concurrently \"npx @11ty/eleventy --serve\" \"npx tailwindcss -i ./src/css/input.css -o ./_site/css/style.css --watch\"",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "concurrently": "^9.0.0",
    "tailwindcss": "^3.4.0"
  }
}
